import module org.openxtalk.library.hidapi
  use com.livecode.foreign
  use com.livecode.engine
  use com.livecode.arithmetic
  use com.livecode.binary
  use com.livecode.list
  use com.livecode.logic
  use com.livecode.string
  use com.livecode.type
  use com.livecode.typeconvert
  use com.livecode.array
  use com.livecode.canvas
  use com.livecode.math
  use com.livecode.system
  use com.livecode.char
  foreign type HIDDevices
  foreign type HIDByteBuffer
  handler HIDAPIInit() returns optional any
  handler HIDAPIExit() returns optional any
  handler HIDAPISetInputFilter(in pFilterText as String) returns optional any
  handler HIDAPISetBlockingMode(in pBlocking as Boolean) returns optional any
  handler HIDAPIOpenFromSystemPath(in pSysPath as ZStringNative) returns optional any
  handler HIDAPIOpen(in pVendorIDHex as String, in pProductIDIDHex as String, in pSerialNumStr as optional ZStringUTF16) returns optional any
  handler HIDAPIClose() returns optional any
  handler HIDAPIReadWithTimeOut(in pParse as optional String, in pWaitMillisecs as Number) returns optional any
  handler HIDAPIRead(in pParse as optional String) returns optional any
  handler HIDAPIEnumerate() returns optional any
  handler getWCharString(in pPointer as Pointer) returns String
  handler getWCharStringSizeOf(in pPointer as Pointer) returns optional Number
  handler getHexStringFromTwoByteNum(in pTwoByteNum as Number) returns optional String
  handler getHexStringFromCUInt(in pByte as CUInt) returns optional String
  handler getBitsStringFromCUInt(in pByte as CUInt) returns optional String
  handler HIDGenericDesktopUsageNumToString(in pUsagePageNumber as Number) returns String
  handler HIDUsagePageNumToString(in pUsagePageNumber as Number) returns String
end module
